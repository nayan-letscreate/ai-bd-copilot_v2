# Copy to .env for local development. NEVER commit the real .env.
# Empty values are treated as "not set", so you can leave anything blank.

# --- App ----------------------------------------------------------------
# development | production (production enforces the checks below)
APP_ENV=development
LOG_LEVEL=INFO
# Public https URL of the deployed service. Needed for HubSpot webhook signature checks and Slack links.
PUBLIC_BASE_URL=
# Comma-separated host names the service answers to (set to your domain in production).
ALLOWED_HOSTS=*
# keep false in production
ENABLE_DOCS=false

# --- Authentication (REQUIRED in production) -----------------------------
# One or more keys, comma-separated (several keys let you rotate without downtime). 24+ characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEYS=

# --- Database -------------------------------------------------------------
# Local:       sqlite:///bd_copilot.db
# Production:  postgresql://user:password@host:5432/dbname   (Render provides this)
DATABASE_URL=sqlite:///bd_copilot.db

# --- Claude (leave the key blank to run in clearly-labelled MOCK mode) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6       # uncomment only to override the default

# --- Research (Tavily free tier: 1000 searches/month; 2 searches per lead) -
TAVILY_API_KEY=

# --- HubSpot (Private App token) ------------------------------------------
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write
# Optional: crm.schemas.contacts.write lets the app create its two custom properties
# (ai_lead_score, ai_research_summary) automatically.
HUBSPOT_TOKEN=
# Client secret used to verify X-HubSpot-Signature-v3 on POST /webhook/hubspot. Without it the webhook is disabled.
HUBSPOT_CLIENT_SECRET=

# --- Slack (choose ONE mode) ----------------------------------------------
# Notify-only: an Incoming Webhook URL. Approvals then happen in the dashboard.
SLACK_WEBHOOK_URL=
# Interactive (Approve / Reject buttons): set all three, plus who is allowed to click.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to approve. Empty means NOBODY can approve from Slack.
SLACK_APPROVER_IDS=

# --- Outreach e-mail --------------------------------------------------------
# Safe default: false = dry run (approvals are recorded, nothing is emailed).
OUTREACH_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required when sending: unsubscribe instruction and postal address (CAN-SPAM / GDPR expectations).
OUTREACH_FOOTER=
MAX_SENDS_PER_DAY=50

# --- Business context used in prompts -----------------------------------------
# ICP_DESCRIPTION=
# BUSINESS_DESCRIPTION=
# SENDER_NAME=The Partnerships Team

# --- Cost-saving triage model (docs/TRIAGE_ML.md) --------------------------------
# off:    never score leads with the model.
# shadow: record what the model WOULD skip, but process every lead (default; costs nothing).
# active: let the model skip likely poor fits, but only while its measured record is good.
TRIAGE_MODE=shadow
# Random share of would-skip leads processed anyway as a spot-check (must be above 0 in active mode).
TRIAGE_EXPLORE_RATE=0.10
# Skipping pauses if more than this share of would-skip leads turn out to be good.
TRIAGE_MAX_SKIPPED_GOOD=0.10
# Share of good leads the cutoff must keep (0.95 = about 95% still processed).
TRIAGE_TARGET_RECALL=0.95
# Labelled leads needed before a model is trained, and good/poor examples needed of each kind.
TRIAGE_MIN_LABELS=200
TRIAGE_MIN_PER_CLASS=30
# Your real prices, so spend and savings estimates mean something (these are placeholders).
LLM_INPUT_USD_PER_MTOK=3.0
LLM_OUTPUT_USD_PER_MTOK=15.0
SEARCH_USD_PER_CALL=0.008

# --- Guardrails ------------------------------------------------------------------
# hard daily cap on new leads (bounds LLM spend)
MAX_LEADS_PER_DAY=500
MAX_BATCH_ROWS=200
RATE_LIMIT_PER_MINUTE=120
# 0 = keep forever
DATA_RETENTION_DAYS=0

# --- Worker ----------------------------------------------------------------------
# false on the web service if you run `python -m app.worker` separately
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
MAX_ATTEMPTS=3
